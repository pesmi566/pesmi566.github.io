const cards=[
["Dynamisches Mikrofon: Aufbau?","Kapsel mit Metallfolie (Membran) im permanenten Magnetfeld."],
["Dynamisch: Wandlungskette?","Schall → mechanische Schwingung → magnetische Spannung → Modulationsspannung → Kabel."],
["Rückwandlung beim Hören?","Spannung → mechanische Schwingungen → Schall (genau andersherum)."],
["Kondensatormikrofon: Aufbau?","Metallmembran mit Gegenelektrode = zwei Kondensatorplatten."],
["Kondensator: Wie entsteht das Signal?","Schall bewegt die Membran → Elektrodenabstand ändert sich → Spannung ändert sich."],
["Warum braucht ein Kondensatormikrofon externe Spannung?","Die Kondensatorplatten müssen ständig aufgeladen werden (Batterie oder Phantomspeisung)."],
["Phantomspeisung: Spannung?","Üblicherweise 9 bis 48 V, vom Mixer oder einer Stromquelle durchs Mikrofonkabel; lädt die Kondensatorplatten."],
["Schadet Phantomspeisung einem dynamischen Mikrofon?","Nein. An PIN 2 und 3 des XLR-Steckers liegt eine Spannung mit identischem Potenzial an."],
["An-/Aus-Schalter: dynamisch vs. Kondensator?","Dynamisch: unterbricht den Signalfluss. Kondensator: schaltet die Spannungsversorgung aus."],
["Frequenzgang – Definition?","Charakteristischer Frequenzbereich eines Mikrofons samt Verlauf seiner frequenzabhängigen Empfindlichkeit."],
["Hörbereich Mensch / Stimme?","Gehör: ca. 20–20 000 Hz. Stimme: hauptsächlich ca. 75 Hz – 10 kHz."],
["Ebener vs. konturierter Frequenzgang?","Eben: gesamtes Spektrum gleichmäßig. Konturiert (shaped): bestimmte Bereiche betont – häufig bei dynamischen Mikrofonen."],
["Stärken des Kondensatormikrofons?","Flacherer Frequenzgang, dünne Membran (sensibel für Höhen), leise/differenzierte Signale, großer Abstand, tiefe Töne (v. a. Kugel)."],
["Stärken des dynamischen Mikrofons?","Laute Signale unverzerrt, geringes thermisches Rauschen, Live-Gesang, Durchsetzung im Mix."],
["Grenze des Kondensatormikrofons bei Lautstärke?","Selten Pegel von ca. 140 dB und mehr ohne erhebliche Verzerrung."],
["Rauschen im Vergleich?","Dynamisch: nur äußerst geringes thermisches Rauschen. Kondensator: zusätzlich Strom-, Spannungs- und Funkelrauschen."],
["Feuchtigkeit/Temperatur?","Bei Kondensatormikrofonen (bes. älteren): Nebengeräusche, in schweren Fällen Totalausfall."],
["Spinne?","Elastische Aufhängung; entkoppelt vom Untergrund (Trittschall, Verkehrslärm)."],
["Poppschutz vs. Windschutz?","Popp: aufgespannter Stoff, einige cm Abstand, innen, gegen Plosive (b, p, t, d, k). Wind: Schaumstoff, direkt aufgesteckt, außen/live."],
["Direktsignal & Abstand?","Klang ohne Umweg zum Mikrofon; −6 dB bei jeder Entfernungsverdopplung."],
["„In Your Face“?","Membran direkt auf den Mund, nächste Nähe; sehr direkt, vordergründig, viel Nahbesprechungseffekt; gleicht Klangfülle-Defizite bei Rock/Pop aus."],
["Mikrofon von oben?","Auf die Nasenwurzel gerichtet, Schwenk ± 22,5°; eher nasal, mittenbetont; Popp- und Hisslaute weniger stark."]];
let order=cards.map((_,i)=>i),ci=0,flip=false,known=new Set(ST.get("known",[]));
function rc(){const k=order[ci];$("fcard").innerHTML=`<div><small>${flip?"Antwort":"Frage"} · Karte ${ci+1}/${cards.length}${known.has(k)?" · ✓":""}</small>${flip?cards[k][1]:cards[k][0]}</div>`;$("fbar").style.width=(known.size/cards.length*100)+"%";$("fc2").textContent=known.size+" von "+cards.length+" gewusst"}
$("fcard").onclick=()=>{flip=!flip;rc()};$("fcard").onkeydown=e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();flip=!flip;rc()}};
$("fn").onclick=()=>{ci=(ci+1)%cards.length;flip=false;rc()};$("fp").onclick=()=>{ci=(ci-1+cards.length)%cards.length;flip=false;rc()};
$("fk").onclick=()=>{known.add(order[ci]);ST.set("known",[...known]);$("fn").click();ck()};
$("fm").onclick=()=>{order.sort(()=>Math.random()-.5);ci=0;flip=false;rc()};
const qs=[
["Welche Spannung ist bei der Phantomspeisung üblich?",["1,5 bis 3 V","9 bis 48 V","110 bis 230 V"],1,"Üblich sind 9 bis 48 V; sie laden die Kondensatorplatten auf."],
["Was passiert mit einem dynamischen Mikrofon, wenn die Phantomspeisung versehentlich an ist?",["Es wird zerstört","Es verliert Empfindlichkeit","Nichts – PIN 2 und 3 haben identisches Potenzial"],2,"Beide Signalleitungen liegen auf gleichem Potenzial, daher kein Schaden."],
["Wodurch entsteht das Signal im Kondensatormikrofon?",["Spule im Magnetfeld","Änderung des Elektrodenabstands","Erwärmung der Membran"],1,"Die Membran schwingt, der Abstand zur Gegenelektrode ändert sich, damit die Spannung."],
["Was bewirkt der Schalter bei einem Kondensatormikrofon?",["Unterbricht den Signalfluss","Schaltet die Spannungsversorgung aus","Wechselt den Frequenzgang"],1,"Beim dynamischen unterbricht er den Signalfluss, beim Kondensator die Versorgung."],
["Welches Mikrofon verarbeitet sehr hohe Schalldruckpegel besser unverzerrt?",["Dynamisch","Kondensator","Beide gleich"],0,"Kondensatormikrofone verzerren bei ca. 140 dB und mehr leicht."],
["Warum bildet das Kondensatormikrofon Höhen gut ab?",["Dickere Membran","Dünnere, sensiblere Membran","Größeres Gehäuse"],1,"Dünne Membran reagiert sensibler auf Schallwellen hoher Töne."],
["Was bedeutet ein konturierter Frequenzgang?",["Alle Frequenzen gleich laut","Bestimmte Bereiche werden betont","Das Mikrofon nimmt nichts auf"],1,"Shaped = bestimmte Frequenzbereiche betont, häufig bei dynamischen Mikrofonen."],
["Welche Rauschart haben dynamische Mikrofone nur?",["Funkelrauschen","Spannungsrauschen","Thermisches Eigenrauschen"],2,"Äußerst gering, durch Widerstände verursacht."],
["Welches Zubehör entkoppelt das Mikrofon vom Untergrund?",["Spinne","Poppschutz","Windschutz"],0,"Die Spinne verhindert Trittschall und Verkehrslärm."],
["Warum wirkt ein Poppschutz gegen Plosive besser als ein Windschutz?",["Er ist dicker","Er sitzt in größerem Abstand zur Membran","Er besteht aus Metall"],1,"Der Abstand von einigen cm verteilt den Luftzug vor der Membran."],
["Pegel 62 dB bei 10 cm. Wie hoch bei 20 cm?",["58 dB","56 dB","31 dB"],1,"Verdopplung des Abstands = −6 dB."],
["Welche Technik klingt eher nasal und mittenbetont?",["In Your Face","Von oben","Beide"],1,"Von oben (auf die Nasenwurzel); Popp- und Hisslaute fallen weniger ins Gewicht."]];
let qi=0,qs0=0,done=false;
function rq(){const q=$("quiz");if(qi>=qs.length){q.innerHTML=`<b>Ergebnis: ${qs0} von ${qs.length}</b><p>${qs0>=11?"Sehr stark!":qs0>=8?"Gut – wiederhole die falschen Themen.":"Nutze die Lernkarten und versuche es erneut."}</p><button class="b p" id="qr">Nochmal</button>`;ST.set("best",Math.max(ST.get("best",0),qs0));$("qr").onclick=()=>{qi=0;qs0=0;rq()};return}
const[x,o,a,e]=qs[qi];done=false;q.innerHTML=`<div class="bar"><i style="width:${qi/qs.length*100}%"></i></div><small style="color:var(--mu)">Frage ${qi+1}/${qs.length} · Bestwert: ${ST.get("best",0)}</small><p><b>${x}</b></p>`+o.map((t,i)=>`<button class="b opt" data-i="${i}">${t}</button>`).join("")+`<div id="qf"></div>`;
q.querySelectorAll(".opt").forEach(b=>b.onclick=()=>{if(done)return;done=true;const i=+b.dataset.i;if(i==a)qs0++;q.querySelectorAll(".opt").forEach((c,j)=>{if(j==a)c.classList.add("r");else if(j==i)c.classList.add("w")});$("qf").innerHTML=`<div class="fb"><b>${i==a?"Richtig!":"Nicht ganz."}</b> ${e}</div><div class="row"><button class="b p" id="qn">Weiter</button></div>`;$("qn").onclick=()=>{qi++;rq()}})}
const D=[2.5,5,10,20,40,80];
$("sl").oninput=()=>{const n=+$("sl").value,d=D[n],db=80-6*n;$("dist").textContent=String(d).replace(".",",")+" cm";$("dbl").textContent=n;$("lvl").textContent=db+" dB";$("lb").style.width=(db-45)/35*100+"%";$("lt").textContent=n==0?"Sehr nah: direkter, vordergründiger Klang (vgl. „In Your Face“).":"Je weiter weg, desto leiser das Direktsignal: "+n+" × −6 dB = −"+6*n+" dB."};
$("chk").onclick=()=>{const v=+$("ans").value;$("chkr").innerHTML=v==50?`<div class="fb"><b>Richtig:</b> 5 → 10 → 20 → 40 cm sind drei Verdopplungen, 68 − 18 = 50 dB.</div>`:`<div class="fb" style="background:var(--nobg)">Zähle die Verdopplungen von 5 auf 40 cm (3) und ziehe je 6 dB ab.</div>`};
const QA=[["1", "Nenne die beiden in der Praxis am weitesten verbreiteten Mikrofontypen und erkläre, was „elektroakustische Schallwandlung“ bedeutet.", "<b>Dynamisch<\/b> und <b>Kondensator<\/b>. Elektroakustische Schallwandlung heißt: Ein akustisches Signal (Schall) wird in ein elektrisches Signal (Spannung) umgewandelt."], ["2", "Beschreibe den Aufbau eines dynamischen Mikrofons und erkläre die Schallwandlung in der richtigen Reihenfolge.", "Im Mikrofonkopf sitzt eine Kapsel mit einer Metallfolie (Membran) im <b>permanenten Magnetfeld<\/b>. Ablauf: Schall trifft Membran → mechanische Schwingungen → magnetische Spannung → <b>Modulationsspannung<\/b>, die über das Kabel weitergeleitet wird. Die Folie verformt sich durch den Schall, wodurch eine Spannungsänderung entsteht."], ["3", "Wie funktioniert die Rückwandlung vom elektrischen Signal zum hörbaren Schall?", "Rückwandlung genau umgekehrt: <b>Spannung → mechanische Schwingungen → Schall<\/b>, z. B. an einer Lautsprechermembran. Das ist auch der Grund, warum die Wandlung im dynamischen Mikrofon „umgekehrt wie bei Lautsprechern“ beschrieben wird."], ["4", "Beschreibe Aufbau und Funktionsweise eines Kondensatormikrofons. Warum braucht es eine Spannung von außen?", "Gegenüber einer <b>Metallmembran<\/b> ist eine <b>Gegenelektrode<\/b> angebracht (zwei Kondensatorplatten). Schall versetzt die Membran in Schwingung, der <b>Abstand der Elektroden<\/b> ändert sich, dadurch ändert sich die <b>Spannung<\/b> zwischen ihnen; diese Änderung wird über das Kabel übertragen. Eine Spannung von außen (Batterie oder Kabel) ist nötig, weil die Platten <b>ständig aufgeladen<\/b> sein müssen."], ["5", "Was ist Phantomspeisung? Welche Spannung ist üblich, woher kommt sie und wozu dient sie?", "Vom <b>Mixer oder einer (manchmal separaten) Stromquelle<\/b> wird durch das Mikrofonkabel eine Betriebsspannung von üblicherweise <b>9 bis 48 V<\/b> gesendet. Sie dient der <b>Aufladung der Kondensatorplatten<\/b> und versorgt damit Kondensatormikrofone ohne Batterie."], ["6", "Ein Musiker behauptet, Phantomspeisung „zerschießt“ dynamische Mikrofone. Nimm Stellung und begründe technisch.", "Das ist ein <b>Mythos<\/b>. Beim XLR-Stecker liegt an <b>PIN 2 und 3<\/b> eine Spannung mit <b>identischem Potenzial<\/b> an; es gibt keine Spannungsdifferenz über der Schwingspule des dynamischen Mikrofons. Deshalb passiert nichts, wenn man die Phantomspeisung versehentlich einschaltet."], ["7", "Was bewirkt ein An-/Aus-Schalter bei einem dynamischen und bei einem Kondensatormikrofon?", "<b>Dynamisch:<\/b> Der Schalter <b>unterbricht den Signalfluss<\/b>. <b>Kondensator:<\/b> Der Schalter <b>schaltet die Spannungsversorgung aus<\/b>. Schalter gibt es nur bei einigen Modellen."], ["8", "Definiere „Frequenzgang“ und nenne den Hörbereich des Menschen sowie den für die Stimme wichtigen Bereich.", "Frequenzgang = der charakteristische Frequenzbereich, in dem ein Mikrofon Signale aufnimmt, einschließlich des Verlaufs seiner frequenzabhängigen Empfindlichkeit. Gehör: im Mittel <b>20–20 000 Hz<\/b>; Stimme: hauptsächlich <b>ca. 75 Hz – 10 kHz<\/b>."], ["9", "Erkläre den Unterschied zwischen ebenem und konturiertem Frequenzgang. Welcher Mikrofontyp hat häufig welchen?", "<b>Eben:<\/b> Das gesamte Frequenzspektrum wird gleichmäßig abgebildet (oft bei Kondensatormikrofonen, die „mitunter deutlich flacher“ sind). <b>Konturiert (shaped):<\/b> bestimmte Bereiche werden betont (häufig bei dynamischen Mikrofonen, z. B. gesangsoptimiert → Durchsetzungskraft im Mix)."], ["10", "Nenne vier Stärken des Kondensatormikrofons und begründe eine davon mit dem Membranaufbau.", "(1) Flacherer, ausgewogenerer Frequenzgang. (2) Gute Abbildung hoher Frequenzen. (3) Gute Abbildung tiefer Töne, besonders mit Kugel-Charakteristik. (4) Eignet sich für leise, äußerst differenzierte Signale und großen Mikrofonabstand. Begründung: Die Membran ist <b>dünner<\/b> und reagiert dadurch <b>sensibler auf Schallwellen hoher Töne<\/b>."], ["11", "Wann sind dynamische Mikrofone die bessere Wahl? Nenne mindestens drei Gründe/Einsatzfelder.", "(1) <b>Hohe Schalldruckpegel<\/b> werden unverzerrt eingefangen (Kondensatormikrofone verzerren bei ca. 140 dB und mehr leicht). (2) <b>Live-Gesang<\/b> ist oft erste Wahl. (3) <b>Sehr laute Vocals im Studio<\/b> (Hardrock/Heavy Metal). (4) <b>Gesangsoptimierte Ausführungen<\/b> bringen mehr Durchsetzungskraft im Mix. Zusätzlich: nur äußerst geringes thermisches Rauschen, keine Spannungsversorgung nötig."], ["12", "Vergleiche das Eigenrauschen dynamischer und Kondensatormikrofone. Welche Rauscharten treten auf?", "<b>Dynamisch:<\/b> nur äußerst geringes <b>thermisches Eigenrauschen<\/b> (durch Widerstände). <b>Kondensator:<\/b> zusätzlich <b>Strom-, Spannungs- und Funkelrauschen<\/b>. Hochwertige Kondensatormikrofone haben hauptsächlich <b>tieffrequente<\/b> Rauschanteile, die das Gehör nicht so deutlich wahrnimmt. Je hochwertiger Aufbau und Verarbeitung, desto geringer die Nebengeräusche."], ["13", "Wie wirken sich Feuchtigkeit und große Temperaturunterschiede aus, und welcher Typ ist betroffen?", "Bei <b>Kondensatormikrofonen<\/b> (besonders älteren Modellen) können Feuchtigkeit und große Temperaturunterschiede <b>Nebengeräusche<\/b> und in schweren Fällen <b>Totalausfälle<\/b> verursachen. Hochwertige Verarbeitung verringert das Problem."], ["14", "Erkläre die Unterschiede zwischen Spinne, Poppschutz und Windschutz (Zweck, Einsatz, Befestigung).", "<b>Spinne:<\/b> elastische Aufhängung für Studiomikrofone, entkoppelt vom Untergrund und verhindert Boden-/Trittschall und Verkehrslärm. <b>Poppschutz:<\/b> aufgespannter feiner Stoff in einigen cm Abstand zur Membran, bei Innenaufnahmen/Sprache/Großmembran-Kondensatoren; teilt und lenkt den Luftzug von Plosivlauten (b, p, t, d, k) ab. <b>Windschutz:<\/b> Schaumstoff, direkt aufs Mikrofon gesteckt, ursprünglich für Außenaufnahmen (auch live), verteilt und lenkt den Luftstrom um; als Poppschutz nur bedingt geeignet, weil er nah an der Membran sitzt."], ["15", "Was ist das Direktsignal, und wie verändert sich sein Pegel bei Verdopplung der Entfernung? Gib ein Zahlenbeispiel.", "Direktsignal = Klang, der ohne Umweg direkt von der Quelle zum Mikrofon gelangt. Bei <b>jeder Entfernungsverdopplung<\/b> sinkt der Pegel um etwa <b>−6 dB<\/b>. Beispiel aus dem Blatt: 62 dB bei 10 cm → 56 dB bei 20 cm → 50 dB bei 40 cm."], ["A1", "Eine Metal-Band nimmt im Studio extrem laute Vocals auf. Welches Mikrofon wählst du und warum? Welche Nachteile hätte die Alternative?", "<b>Dynamisches Mikrofon:<\/b> Es fängt hohe Schalldruckpegel besser <b>unverzerrt<\/b> ein; manche Metal-/Hardrock-Produzenten verwenden es deshalb sogar im Studio für sehr laute Vocals. Zusätzlich: nur äußerst geringes thermisches Rauschen, keine Phantomspeisung nötig, und gesangsoptimierte Modelle bringen Durchsetzungskraft im Mix. Die Alternative (Kondensator) kann Pegel von ca. <b>140 dB und mehr<\/b> nur selten ohne erhebliche Verzerrung verarbeiten – bei extrem lauten Vocals droht also Verzerrung."], ["A2", "Du sollst eine sehr leise, differenzierte Quelle mit großem Mikrofonabstand aufnehmen. Welchen Typ wählst du, was musst du technisch beachten und welche Risiken gibt es bei Raumbedingungen?", "<b>Kondensatormikrofon<\/b> (Großmembran/Kugel-Charakteristik ist laut Blatt für tiefe Töne vorteilhaft): Es ist für tiefe, äußerst differenzierte, sehr leise Signale und für großen Mikrofonabstand hervorragend geeignet. Beachten: Spannungsversorgung (Phantomspeisung 9–48 V oder Batterie) einschalten, auf Rauschen achten (hochwertig = überwiegend tieffrequent, kaum hörbar) und den Abstand bedenken, denn das Direktsignal verliert pro Verdopplung 6 dB. Risiko: <b>Feuchtigkeit und große Temperaturunterschiede<\/b> können Nebengeräusche oder Totalausfälle auslösen (besonders ältere Modelle) – Raum und Lagerung kontrollieren."], ["A3", "Ein Sänger steht 5 cm vor dem Mikrofon (Pegel 68 dB). Berechne den Pegel bei 10 cm, 20 cm und 40 cm. Was bedeutet das für die Aufnahme und wie wirkt sich ein Abstandswechsel auf den Klang aus?", "5 cm = 68 dB → <b>10 cm: 62 dB<\/b> (−6) → <b>20 cm: 56 dB<\/b> (−12) → <b>40 cm: 50 dB<\/b> (−18). Je weiter weg, desto leiser das Direktsignal (Gain muss ggf. angepasst werden). Klanglich wird der Aufnahmeklang bei kurzem Abstand <b>direkter und vordergründiger<\/b> (große Anteile Nahbesprechungseffekt); bei größerem Abstand nimmt der Anteil des Direktsignals ab und die Aufnahme wird distanzierter. <i>(Letzteres ist eine sinngemäße Ableitung.)<\/i>"], ["A4", "Ein Kondensatormikrofon liefert plötzlich kein Signal. Nenne mögliche Ursachen laut Informationsblatt und gib eine sinnvolle Prüfreihenfolge an.", "Mögliche Ursachen: (1) <b>Phantomspeisung nicht eingeschaltet<\/b> bzw. keine Batterie (Platten werden nicht aufgeladen); (2) <b>An-/Aus-Schalter am Mikrofon<\/b> steht auf „aus“ (bei Kondensatormikrofonen schaltet er die Spannungsversorgung aus); (3) <b>Feuchtigkeit oder große Temperaturunterschiede<\/b> (Totalausfall besonders bei älteren Modellen); (4) Kabel/Anschluss defekt <i>(Zusatzwissen, nicht im Blatt)<\/i>. Sinnvolle Reihenfolge: Schalter am Mikrofon → Phantomspeisung am Mixer → Umgebungsbedingungen → Kabel/Anschlüsse."], ["A5", "Eine Pop-Sängerin klingt auf der Aufnahme dünn, soll aber voll und präsent klingen; später stören Plosivlaute. Wähle eine Mikrofonierungstechnik, beschreibe Position und Zubehör und nenne die Alternative mit ihrem Klangcharakter.", "<b>„In Your Face“:<\/b> Membran direkt auf den Mund, Mikrofon in nächster Nähe; gleicht Klangfülle- und Resonanzdefizite bei Rock/Pop am besten aus, klingt direkt und vordergründig mit viel Nahbesprechungseffekt. Plosivlaute lassen sich durch einen <b>Poppschutz (einige cm vor der Membran)<\/b> mindern. <b>Alternative „von oben“:<\/b> auf die Nasenwurzel gerichtet, ggf. vertikaler Schwenk bis ± 22,5°; Klang eher nasal und mittenbetont, dafür fallen Popp- und Hisslaute weniger ins Gewicht."]];
